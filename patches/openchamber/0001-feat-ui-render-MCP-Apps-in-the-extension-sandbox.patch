index 0000000..2dafb27
--- /dev/null
+++ b/packages/ui/src/lib/opencode/mcp-app.test.ts
@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test';
+import { createMcpAppBridge } from './mcp-app';
+
+test('initialization grants no host capabilities', async () => {
+  const bridge = createMcpAppBridge({ server: 'demo', callTool: async () => ({ content: [] }) });
+  expect(await bridge.receive({ data: { jsonrpc: '2.0', id: 1, method: 'ui/initialize', params: {
+    protocolVersion: '2026-01-26', appCapabilities: {}, appInfo: { name: 'fixture', version: '1' },
+  } } })).toEqual({ jsonrpc: '2.0', id: 1, result: {
+    protocolVersion: '2026-01-26', hostInfo: { name: 'OpenChamber', version: '2.5.0' },
+    hostCapabilities: {}, hostContext: { displayMode: 'inline', containerDimensions: { height: 320 } },
+  } });
+});
+
+test('malformed messages and unsolicited notifications have no host effects', async () => {
+  let calls = 0;
+  const bridge = createMcpAppBridge({ server: 'demo', callTool: async () => { calls += 1; return { content: [] }; } });
+  for (const data of [null, [], 'tools/call', { jsonrpc: '1.0', id: 3, method: 'tools/call' },
+    { jsonrpc: '2.0', method: 'tools/call', params: { name: 'increment' } }]) {
+    expect(await bridge.receive({ data })).toBeNull();
+  }
+  expect(calls).toBe(0);
+});
+
+test('only initialized apps can call tools, always on their own server', async () => {
+  const calls: unknown[] = [];
+  const result = { content: [{ type: 'text', text: '2' }], structuredContent: { count: 2 }, _meta: { test: true } };
+  const bridge = createMcpAppBridge({ server: 'demo', callTool: async (call) => { calls.push(call); return result; } });
+  const request = { jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'increment', arguments: { by: 1 } } };
+  expect(await bridge.receive({ data: request })).toMatchObject({ id: 2, error: { code: -32000 } });
+  await bridge.receive({ data: { jsonrpc: '2.0', id: 1, method: 'ui/initialize' } });
+  expect(await bridge.receive({ data: { jsonrpc: '2.0', method: 'ui/notifications/initialized' } })).toBeNull();
+  expect(await bridge.receive({ data: request })).toEqual({ jsonrpc: '2.0', id: 2, result });
+  expect(calls).toEqual([{ server: 'demo', tool: 'increment', arguments: { by: 1 } }]);
+  expect(await bridge.receive({ data: { ...request, params: { ...request.params, server: 'other' } } })).toMatchObject({ error: { code: -32602 } });
+  for (const method of ['ui/open-link', 'ui/message', 'resources/read', 'ping']) {
+    expect(await bridge.receive({ data: { ...request, method } })).toMatchObject({ error: { code: -32601 } });
+  }
+  expect(calls).toHaveLength(1);
+});
diff --git a/packages/ui/src/lib/opencode/mcp-app.ts b/packages/ui/src/lib/opencode/mcp-app.ts
new file mode 100644
index 0000000..1a0cd42
--- /dev/null
+++ b/packages/ui/src/lib/opencode/mcp-app.ts
@@ -0,0 +1,63 @@
+import { z } from 'zod';
+import type { JsonValue, Metadata } from './model';
+
+const appSchema = z.object({ server: z.string().min(1), ui: z.object({
+  html: z.string(), meta: z.object({ ui: z.object({ csp: z.object({
+    connectDomains: z.array(z.string()).optional(), resourceDomains: z.array(z.string()).optional(),
+  }).optional() }).optional() }).optional(),
+}) });
+export function getMcpApp(metadata: Metadata | undefined) {
+  const parsed = z.object({ mcp: appSchema }).safeParse(metadata);
+  return parsed.success ? parsed.data.mcp : null;
+}
+export type McpApp = z.infer<typeof appSchema>;
+
+const requestSchema = z.object({
+  jsonrpc: z.literal('2.0'), id: z.union([z.string(), z.number()]).optional(),
+  method: z.string(), params: z.json().optional(),
+});
+const callParamsSchema = z.object({
+  name: z.string().min(1), arguments: z.record(z.string(), z.json()).optional(), server: z.string().optional(),
+}).strict();
+export const mcpAppCallResultSchema = z.object({
+  content: z.array(z.json()), structuredContent: z.record(z.string(), z.json()).optional(),
+  isError: z.boolean().optional(), _meta: z.record(z.string(), z.json()).optional(),
+}).catchall(z.json());
+export type McpAppCallResult = z.infer<typeof mcpAppCallResultSchema>;
+export type McpAppToolCall = { server: string; tool: string; arguments: Record<string, JsonValue> };
+
+export function createMcpAppBridge(options: { server: string; callTool: (call: McpAppToolCall) => Promise<McpAppCallResult> }) {
+  let initialized = false;
+  let initializing = false;
+  return {
+    async receive(event: Pick<MessageEvent, 'data'>) {
+      const parsed = requestSchema.safeParse(event.data);
+      if (!parsed.success) return null;
+      const request = parsed.data;
+      if (request.id === undefined) {
+        if (request.method === 'ui/notifications/initialized' && initializing) initialized = true;
+        return null;
+      }
+      const error = (code: number, message: string) => ({ jsonrpc: '2.0', id: request.id, error: { code, message } });
+      if (request.method === 'ui/initialize') {
+        initializing = true;
+        return { jsonrpc: '2.0', id: request.id, result: {
+          protocolVersion: '2026-01-26', hostInfo: { name: 'OpenChamber', version: '2.5.0' },
+          hostCapabilities: {}, hostContext: { displayMode: 'inline', containerDimensions: { height: 320 } },
+        } };
+      }
+      if (request.method !== 'tools/call') return error(-32601, 'Method not found');
+      if (!initialized) return error(-32000, 'App is not initialized');
+      const params = callParamsSchema.safeParse(request.params);
+      if (!params.success || (params.data.server !== undefined && params.data.server !== options.server)) {
+        return error(-32602, 'Invalid tool call or server');
+      }
+      try {
+        const result = await options.callTool({ server: options.server, tool: params.data.name, arguments: params.data.arguments ?? {} });
+        return { jsonrpc: '2.0', id: request.id, result };
+      } catch {
+        return error(-32000, 'Tool call failed or permission denied');
+      }
+    },
+  };
+}
