index b55c090..e92db66 100644
--- a/packages/ui/src/components/chat/message/parts/DOCUMENTATION.md
+++ b/packages/ui/src/components/chat/message/parts/DOCUMENTATION.md
@@ -89,6 +89,34 @@ Use this doc when you ask an agent to change tool/header/description behavior.
 
 ## Current important behavior
 
+### MCP Apps proof
+
+Web and Electron render `state.metadata.mcp.ui.html` at the start of the expanded
+tool result, including empty text and error results. VS Code, hosted mobile and
+Capacitor retain their existing text output. The tool row remains collapsible;
+folding it destroys the app's local state.
+
+`McpAppFrame` uses the extension `allow-scripts` opaque-origin frame and the
+shared `prependGuestFramePolicy` srcDoc path. The resource is not an installed
+extension and receives no extension grants. The metadata adapter parses
+`ui.meta.ui.csp.connectDomains` and `resourceDomains`; this proof approves no
+origins and passes an empty origin list to the extension policy. Browser-level
+CSP enforcement is deferred to T6 Playwright and the final Electron pass.
+
+The JSON-RPC adapter supports only `ui/initialize`,
+`ui/notifications/initialized` and `tools/call`. Initialization advertises empty
+host capabilities. Calls after initialization are restricted to the part's MCP
+server, show a visible tool-request status, and use the owning `part.sessionID`
+and session directory. Server-side permission requests still reach PermissionDock.
+Missing ownership fails closed. Exact source-window identity, runtime identity,
+effect cleanup and frame ownership gate requests and asynchronous replies.
+
+### Why the extension policy is reused
+
+This disposable proof reuses the existing extension isolation rules and CSP
+injection. The MCP Apps double-frame sandbox and additional host methods remain
+outside its scope.
+
 ### Bidirectional prose
 
 Shared chat CSS applies `unicode-bidi: plaintext` to prose blocks, including
diff --git a/packages/ui/src/components/chat/message/parts/McpAppFrame.tsx b/packages/ui/src/components/chat/message/parts/McpAppFrame.tsx
new file mode 100644
index 0000000..2afdb2d
--- /dev/null
+++ b/packages/ui/src/components/chat/message/parts/McpAppFrame.tsx
@@ -0,0 +1,58 @@
+import React from 'react';
+import { createMcpAppBridge, type McpApp } from '@/lib/opencode/mcp-app';
+import { opencodeClient } from '@/lib/opencode/client';
+import { prependGuestFramePolicy } from '@/lib/guests/frame-document';
+import { getAllSyncSessionMap, getSyncSessionDirectory } from '@/sync/sync-refs';
+import { getRuntimeKey, subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+import { useI18n } from '@/lib/i18n';
+
+export function McpAppFrame({ app, sessionID }: { app: McpApp; sessionID: string }) {
+  const { t } = useI18n();
+  const frameRef = React.useRef<HTMLIFrameElement>(null);
+  const [callStatus, setCallStatus] = React.useState<{ tool: string; failed: boolean } | null>(null);
+  const srcDoc = React.useMemo(() => {
+    const document = new DOMParser().parseFromString(app.ui.html, 'text/html');
+    // shortcut: declared CSP origins stay unapproved in this proof; add user grants before enabling them.
+    prependGuestFramePolicy(document);
+    return `<!doctype html>\n${document.documentElement.outerHTML}`;
+  }, [app.ui.html]);
+
+  React.useEffect(() => {
+    const frame = frameRef.current;
+    const runtimeKey = getRuntimeKey();
+    const controller = new AbortController();
+    let disposed = false;
+    const ownsFrame = () => !disposed && frame !== null && frameRef.current === frame && getRuntimeKey() === runtimeKey;
+    const bridge = createMcpAppBridge({ server: app.server, callTool: async (call) => {
+      if (!ownsFrame()) throw new Error('App is no longer active');
+      const directory = getAllSyncSessionMap().get(sessionID)?.directory ?? getSyncSessionDirectory(sessionID);
+      if (!directory) throw new Error('Owning session directory is unavailable');
+      setCallStatus({ tool: call.tool, failed: false });
+      try {
+        return await opencodeClient.callMcpTool({ sessionID, ...call }, directory, controller.signal);
+      } catch (error) {
+        if (ownsFrame()) setCallStatus({ tool: call.tool, failed: true });
+        throw error;
+      }
+    } });
+    const onMessage = (event: MessageEvent) => {
+      if (!ownsFrame() || event.source !== frame?.contentWindow) return;
+      void bridge.receive(event).then((reply) => {
+        // Opaque origins require '*'; exact source identity and ownership gate both directions.
+        if (reply && ownsFrame()) frame?.contentWindow?.postMessage(reply, '*');
+      });
+    };
+    const unsubscribe = subscribeRuntimeEndpointChanged(() => { disposed = true; controller.abort(); });
+    window.addEventListener('message', onMessage);
+    return () => { disposed = true; controller.abort(); unsubscribe(); window.removeEventListener('message', onMessage); };
+  }, [app.server, sessionID, srcDoc]);
+
+  return <div>
+    <iframe ref={frameRef} data-testid="mcp-app-frame" title={t('chat.toolPart.mcpAppTitle')}
+      sandbox="allow-scripts" srcDoc={srcDoc} className="w-full h-80 border-0" />
+    <div data-testid="mcp-app-status" role="status" className="typography-meta text-muted-foreground h-5 truncate"
+      title={callStatus ? t(callStatus.failed ? 'chat.toolPart.mcpAppCallFailed' : 'chat.toolPart.mcpAppCall', { tool: callStatus.tool }) : undefined}>
+      {callStatus ? t(callStatus.failed ? 'chat.toolPart.mcpAppCallFailed' : 'chat.toolPart.mcpAppCall', { tool: callStatus.tool }) : ''}
+    </div>
+  </div>;
+}
