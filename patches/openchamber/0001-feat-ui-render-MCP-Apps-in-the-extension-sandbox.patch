diff --git a/packages/ui/src/lib/guests/frame-document.ts b/packages/ui/src/lib/guests/frame-document.ts
new file mode 100644
index 0000000..4aee43d
--- /dev/null
+++ b/packages/ui/src/lib/guests/frame-document.ts
@@ -0,0 +1,9 @@
+import { guestFramePolicy } from '@openchamber/sdk';
+
+/** srcDoc has no response headers; install the extension network policy before guest content. */
+export function prependGuestFramePolicy(document: Document, origins: readonly string[] = []) {
+  const policy = document.createElement('meta');
+  policy.httpEquiv = 'Content-Security-Policy';
+  policy.content = guestFramePolicy(null, origins);
+  document.head.prepend(policy);
+}
