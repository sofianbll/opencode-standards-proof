+import React, { act } from 'react';
+import { expect, test } from 'bun:test';
+import { plugin } from 'bun';
+import { pathToFileURL } from 'node:url';
+import { Window } from 'happy-dom';
+import { OpenCode } from '@opencode/client';
+import { SyncProvider } from '@/sync/sync-context';
+import { I18nProvider } from '@/lib/i18n';
+import { ThemeSystemContext, type ThemeContextValue } from '@/contexts/theme-system-context';
+import { getDefaultTheme } from '@/lib/theme/themes';
+import type { JsonValue, ToolPart as ToolPartData } from '@/lib/opencode/model';
+import { getSyncChildStores } from '@/sync/sync-refs';
+
+plugin({ name: 'mcp-app-worker-url', setup(build) {
+  build.onLoad({ filter: /markdown-shiki\.worker\.ts\?worker&url$/ }, ({ path }) => ({
+    contents: `export default ${JSON.stringify(pathToFileURL(path.split('?')[0]).href)};`, loader: 'js',
+  }));
+} });
+
+const part: ToolPartData = {
+  id: 'prt_app', sessionID: 'ses_owner', messageID: 'msg_app', type: 'tool', tool: 'mcp.demo.show', callID: 'call_app',
+  state: { status: 'completed', input: {}, output: '', time: { start: 1, end: 2 }, metadata: {
+    mcp: { server: 'demo', tool: 'show', ui: { resourceUri: 'ui://demo/app', mimeType: 'text/html;profile=mcp-app',
+      html: '<!doctype html><html><head><script>/* fixture */</script></head><body><button>Increment</button></body></html>',
+      meta: { ui: { csp: { connectDomains: ['https://api.example.com'], resourceDomains: ['https://cdn.example.com'] }, permissions: { camera: {} } } },
+    } },
+  } },
+};
+
+test('an app-only tool result renders an opaque frame with the extension CSP before all guest content', async () => {
+  const browser = new Window({ url: 'http://localhost' });
+  const descriptors = new Map<string, PropertyDescriptor | undefined>();
+  for (const [name, value] of Object.entries({
+    window: browser, document: browser.document, navigator: browser.navigator, localStorage: browser.localStorage,
+    Node: browser.Node, Text: browser.Text, NodeList: browser.NodeList, Element: browser.Element,
+    HTMLElement: browser.HTMLElement, SVGElement: browser.SVGElement, DOMParser: browser.DOMParser, customElements: browser.customElements,
+    ResizeObserver: browser.ResizeObserver, MutationObserver: browser.MutationObserver,
+    requestAnimationFrame: browser.requestAnimationFrame.bind(browser), cancelAnimationFrame: browser.cancelAnimationFrame.bind(browser),
+    getComputedStyle: browser.getComputedStyle.bind(browser), IS_REACT_ACT_ENVIRONMENT: true,
+  })) {
+    descriptors.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { value, configurable: true, writable: true });
+  }
+  const { createRoot } = await import('react-dom/client');
+  const { default: ToolPart } = await import('./ToolPart');
+  const theme = getDefaultTheme(false);
+  const unexpected = (): never => { throw new Error('No theme changes expected'); };
+  const themeContext: ThemeContextValue = {
+    currentTheme: theme, availableThemes: [theme], setTheme: unexpected, customThemesLoading: false,
+    reloadCustomThemes: unexpected, importTheme: unexpected, deleteImportedTheme: unexpected, customThemeIds: [],
+    isSystemPreference: false, setSystemPreference: unexpected, themeMode: 'light', setThemeMode: unexpected,
+    lightThemeId: theme.metadata.id, darkThemeId: getDefaultTheme(true).metadata.id,
+    setLightThemePreference: unexpected, setDarkThemePreference: unexpected,
+  };
+  const sdk = OpenCode.make({ baseUrl: 'http://localhost', fetch: async () => Response.json([]) });
+  const host = document.createElement('div'); document.body.append(host);
+  const root = createRoot(host);
+  const previousFetch = globalThis.fetch;
+  const calls: { url: string; body: string; directory: string | null }[] = [];
+  const result = { content: [{ type: 'text', text: '2' }], structuredContent: { count: 2 } };
+  globalThis.fetch = async (input, init) => {
+    const url = input instanceof Request ? input.url : String(input);
+    if (url.endsWith('/mcp/call')) calls.push({ url, body: String(init?.body), directory: new Headers(init?.headers).get('x-opencode-directory') });
+    return Response.json(url.endsWith('/mcp/call') ? result : {});
+  };
+  try {
+    await act(async () => root.render(<SyncProvider sdk={sdk} directory=""><I18nProvider>
+      <ThemeSystemContext.Provider value={themeContext}>
+        <ToolPart part={part} isExpanded isMobile={false} onToggle={() => {}} />
+      </ThemeSystemContext.Provider>
+    </I18nProvider></SyncProvider>));
+    const frame = host.querySelector<HTMLIFrameElement>('[data-testid="mcp-app-frame"]');
+    expect(frame).not.toBeNull();
+    expect(frame?.getAttribute('sandbox')).toBe('allow-scripts');
+    expect(frame?.getAttribute('allow')).toBeNull();
+    const first = new DOMParser().parseFromString(frame?.srcdoc ?? '', 'text/html').head.firstElementChild;
+    expect(first?.getAttribute('http-equiv')).toBe('Content-Security-Policy');
+    expect(first?.getAttribute('content')).toContain("default-src 'none'");
+    expect(first?.getAttribute('content')).toContain("connect-src 'none'");
+    expect(first?.getAttribute('content')).not.toContain('example.com');
+    expect(host.textContent).not.toContain('resourceUri');
+    if (!frame?.contentWindow) throw new Error('Missing app window');
+    const replies: unknown[] = [];
+    frame.contentWindow.postMessage = (message) => { replies.push(message); };
+    const send = async (data: JsonValue, source = frame.contentWindow) => {
+      const event = new browser.Event('message');
+      Object.defineProperties(event, { source: { value: source }, data: { value: data } });
+      await act(async () => { browser.dispatchEvent(event); });
+    };
+    const store = getSyncChildStores().ensureChild('/repo/container', { bootstrap: false });
+    store.setState({ session: [{ id: part.sessionID, projectID: 'project', directory: '/repo/owner', title: 'Owner',
+      cost: 0, tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }, time: { created: 1, updated: 1 } }] });
+    await send({ jsonrpc: '2.0', id: 1, method: 'ui/initialize' });
+    await send({ jsonrpc: '2.0', method: 'ui/notifications/initialized' });
+    const call = { jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'increment', arguments: { by: 1 } } };
+    const otherFrame = document.createElement('iframe'); document.body.append(otherFrame);
+    await send(call, otherFrame.contentWindow);
+    expect(calls).toHaveLength(0);
+    await send(call);
+    expect(calls).toEqual([{ url: '/api/session/ses_owner/mcp/call',
+      body: JSON.stringify({ server: 'demo', tool: 'increment', arguments: { by: 1 } }), directory: '%2Frepo%2Fowner' }]);
+    expect(replies.at(-1)).toEqual({ jsonrpc: '2.0', id: 2, result });
+    expect(host.querySelector('[data-testid="mcp-app-status"]')?.textContent).toContain('increment');
+    await send({ ...call, params: { ...call.params, server: 'other' } });
+    expect(replies.at(-1)).toMatchObject({ error: { code: -32602 } });
+    await send({ ...call, method: 'ui/open-link' });
+    expect(replies.at(-1)).toMatchObject({ error: { code: -32601 } });
+    expect(calls).toHaveLength(1);
+    let finish: (response: Response) => void = () => { throw new Error('No pending callback'); };
+    globalThis.fetch = async () => new Promise<Response>((resolve) => { finish = resolve; });
+    await send({ ...call, id: 3 });
+    const replyCount = replies.length;
+    await act(async () => root.unmount());
+    await act(async () => finish(Response.json(result)));
+    expect(replies).toHaveLength(replyCount);
+  } finally {
+    globalThis.fetch = previousFetch;
+    await act(async () => root.unmount());
+    await browser.happyDOM.abort();
+    for (const [name, descriptor] of descriptors) {
+      if (descriptor) Object.defineProperty(globalThis, name, descriptor); else Reflect.deleteProperty(globalThis, name);
+    }
+  }
+});
