+                ),
+              )
+            expect(result.metadata?.mcp).toEqual({
+              server: "resources",
+              tool: "echo",
+              toolMeta: { ui: { resourceUri: "ui://demo/counter" }, definition: true },
+              resultMeta: { ...(embedded ? { ui: { resourceUri: "ui://demo/counter" } } : {}), private: "guest-only" },
+              structuredContent: { count: 0 },
+              ui: {
+                resourceUri: "ui://demo/counter",
+                mimeType: "text/html;profile=mcp-app",
+                html: "<h1>Counter</h1>",
+                meta: { ui: { csp: { connectDomains: ["https://example.com"] } } },
+              },
+            })
+            expect(result.content).toEqual([{ type: "text", text: "Counter ready" }])
+            expect(server.state.resourceReads).toEqual(embedded ? [] : ["ui://demo/counter"])
+          }).pipe(
+            Effect.provide(
+              AppNodeBuilder.build(LayerNode.group([Tool.node, McpTool.node]), [
+                Mcp.node.replace(Layer.succeed(Mcp.Service, service)),
+                Permission.node.replace(Layer.mock(Permission.Service, { assert: () => Effect.void })),
+                Bus.node.replace(events),
+                Image.node.replace(imagePassthrough),
+              ]),
+            ),
+          )
+        }).pipe(
+          Effect.provide(
+            resourceMcpLayer(new ConfigMCP.Remote({ type: "remote", url: server.url, oauth: false, codemode: false })),
+          ),
+        )
+      }),
+  )
