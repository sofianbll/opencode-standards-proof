+import { expect, test } from "bun:test"
+import { Schema } from "effect"
+import { Mcp } from "@opencode/schema/mcp"
+import { SessionMessage } from "@opencode/schema/session-message"
+import { makeSessionGroup } from "../src/groups/session.js"
+import { HttpApiMiddleware } from "effect/http-api"
+
+test("MCP callback schemas preserve the full result and session app metadata", () => {
+  class Middleware extends HttpApiMiddleware.Service<Middleware>()("test/session") {}
+  const endpoint = makeSessionGroup(Middleware, Middleware).endpoints["session.mcp.call"]
+  expect(endpoint.path).toBe("/api/session/:sessionID/mcp/call")
+  const request = { server: "demo", tool: "increment_counter", arguments: { by: 1 } }
+  expect(Schema.decodeUnknownSync(Mcp.CallToolInput)(request)).toEqual(request)
+  const result = {
+    content: [
+      {
+        type: "resource",
+        resource: {
+          uri: "ui://demo/counter",
+          mimeType: "text/html;profile=mcp-app",
+          text: "<h1>Counter</h1>",
+          _meta: { ui: { csp: {} } },
+        },
+      },
+    ],
+    structuredContent: { count: 1 },
+    isError: false,
+    _meta: { private: "guest-only" },
+  }
+  expect(Schema.encodeSync(Mcp.CallToolResult)(Schema.decodeUnknownSync(Mcp.CallToolResult)(result))).toEqual(result)
+  const state = {
+    status: "completed",
+    input: {},
+    content: [{ type: "text", text: "Counter ready" }],
+    metadata: {
+      mcp: {
+        server: "demo",
+        tool: "increment_counter",
+        toolMeta: { ui: { resourceUri: "ui://demo/counter" } },
+        resultMeta: result._meta,
+        structuredContent: result.structuredContent,
+        ui: {
+          resourceUri: "ui://demo/counter",
+          mimeType: "text/html;profile=mcp-app",
+          html: "<h1>Counter</h1>",
+          meta: { ui: { csp: {} } },
+        },
+      },
+    },
+  } as const
+  const part = { type: "tool", id: "call_app", name: "demo_increment_counter", state, time: { created: 0 } } as const
+  expect(
+    Schema.encodeSync(SessionMessage.AssistantTool)(Schema.decodeUnknownSync(SessionMessage.AssistantTool)(part)),
+  ).toEqual(part)
+})
