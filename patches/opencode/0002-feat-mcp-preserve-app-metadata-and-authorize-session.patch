@@ -0,0 +1,127 @@
+import { expect } from "bun:test"
+import { Effect, Schema } from "effect"
+import { Session } from "@opencode/schema/session"
+import { createMcpHandler, Server } from "@modelcontextprotocol/server"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+it.live("MCP app callback uses session permissions and returns the full MCP response", () =>
+  Effect.gen(function* () {
+    const calls: unknown[] = []
+    const result = {
+      content: [
+        {
+          type: "resource" as const,
+          resource: { uri: "ui://demo/counter", text: "<h1>Counter</h1>", mimeType: "text/html;profile=mcp-app" },
+        },
+      ],
+      structuredContent: { count: 1 },
+      _meta: { private: "guest-only" },
+    }
+    const mcp = createMcpHandler(
+      () => {
+        const server = new Server({ name: "callback", version: "1" }, { capabilities: { tools: {} } })
+        server.setRequestHandler("tools/list", () =>
+          Promise.resolve({ tools: [{ name: "increment_counter", inputSchema: { type: "object" } }] }),
+        )
+        server.setRequestHandler("tools/call", (request) => {
+          calls.push(request.params)
+          return Promise.resolve(result)
+        })
+        return server
+      },
+      { legacy: "reject" },
+    )
+    const remote = yield* Effect.acquireRelease(
+      Effect.sync(() => Bun.serve({ port: 0, fetch: (request) => mcp.fetch(request) })),
+      (http) =>
+        Effect.promise(async () => {
+          await mcp.close()
+          await http.stop(true)
+        }),
+    )
+    const handler = yield* ServerFetch.make({
+      password: "test-callback-password",
+      app: { version: "test" },
+      database: { path: ":memory:" },
+      config: { project: false },
+      models: { fetch: false },
+      fs: { filewatcher: false },
+    })
+    const post = (path: string, body: unknown, method = "POST") =>
+      Effect.promise(() =>
+        handler(
+          new Request(`http://opencode.local${path}`, {
+            method,
+            headers: {
+              "content-type": "application/json",
+              authorization: `Basic ${btoa("opencode:test-callback-password")}`,
+            },
+            body: JSON.stringify(body),
+          }),
+        ),
+      )
+    const add = yield* post(
+      "/api/experimental/mcp/demo",
+      { config: { type: "remote", url: remote.url.toString(), oauth: false, protocol: "2026-07-28" } },
+      "PUT",
+    )
+    expect(add.status).toBe(204)
+    const unauthenticated = yield* Effect.promise(() =>
+      handler(
+        new Request("http://opencode.local/api/session/ses_missing/mcp/call", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ server: "demo", tool: "increment_counter", arguments: {} }),
+        }),
+      ),
+    )
+    expect(unauthenticated.status).toBe(401)
+    expect(
+      (yield* post("/api/session/ses_missing/mcp/call", { server: "demo", tool: "increment_counter", arguments: {} }))
+        .status,
+    ).toBe(404)
+    for (const effect of ["deny", "allow"]) {
+      const created = yield* post("/api/session", { permissions: [{ action: "*", resource: "*", effect }] })
+      expect(created.status).toBe(200)
+      const session = Schema.decodeUnknownSync(Schema.Struct({ data: Schema.toEncoded(Session.Info) }))(
+        yield* Effect.promise(() => created.json()),
+      ).data
+      const response = yield* post(`/api/session/${session.id}/mcp/call`, {
+        server: "demo",
+        tool: "increment_counter",
+        arguments: { by: 1 },
+      })
+      expect(response.status).toBe(effect === "deny" ? 403 : 200)
+      if (effect === "deny") {
+        expect(calls).toEqual([])
+        continue
+      }
+      expect(yield* Effect.promise(() => response.json())).toEqual({
+        ...result,
+        _meta: { ...result._meta, "io.modelcontextprotocol/serverInfo": { name: "callback", version: "1" } },
+      })
+      expect(calls).toEqual([
+        expect.objectContaining({
+          name: "increment_counter",
+          arguments: { by: 1 },
+          _meta: expect.objectContaining({ "ai.opencode/sessionID": session.id }),
+        }),
+      ])
+      expect(
+        (yield* post(`/api/session/${session.id}/mcp/call`, {
+          server: "missing",
+          tool: "increment_counter",
+          arguments: {},
+        })).status,
+      ).toBe(404)
+      expect(
+        (yield* post(`/api/session/${session.id}/mcp/call`, {
+          server: "demo",
+          tool: "increment_counter",
+          arguments: "invalid",
+        })).status,
+      ).toBe(400)
+    }
+  }).pipe(Effect.scoped),
+)
