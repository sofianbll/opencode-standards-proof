diff --git a/packages/core/src/plugin/agent-package.ts b/packages/core/src/plugin/agent-package.ts
new file mode 100644
index 0000000..a80bf71
--- /dev/null
+++ b/packages/core/src/plugin/agent-package.ts
@@ -0,0 +1,210 @@
+export * as AgentPackage from "./agent-package.js"
+
+import { Effect, Schema } from "effect"
+import { mkdir, readdir, realpath, stat } from "node:fs/promises"
+import path from "node:path"
+import { FSUtil } from "@opencode/util/fs-util"
+import type { Generation } from "./service.js"
+import { Skill } from "@opencode/schema/skill"
+import { Mcp } from "@opencode/schema/mcp"
+import { Hash } from "@opencode/util/hash"
+import { ConfigMarkdown } from "../config/markdown.js"
+import { SkillFile } from "../config/plugin/skill-file.js"
+
+const Manifest = Schema.Struct({
+  $schema: Schema.Literal("https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"),
+  name: Schema.String.check(Schema.isPattern(/^(?!.*--)(?!.*\.\.)(?=.{1,64}$)[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/)),
+  version: Schema.optional(Schema.String),
+  description: Schema.optional(Schema.String),
+  author: Schema.optional(
+    Schema.Struct({
+      name: Schema.optional(Schema.String),
+      email: Schema.optional(Schema.String),
+      url: Schema.optional(Schema.String),
+    }),
+  ),
+  homepage: Schema.optional(Schema.String),
+  repository: Schema.optional(Schema.String),
+  license: Schema.optional(Schema.String),
+  keywords: Schema.optional(Schema.Array(Schema.String)),
+  extensions: Schema.optional(Schema.Unknown),
+})
+
+const Stdio = Schema.Struct({
+  type: Schema.Literal("stdio"),
+  command: Schema.String,
+  args: Schema.optional(Schema.Array(Schema.String)),
+  env: Schema.optional(Schema.Record(Schema.String, Schema.String)),
+  cwd: Schema.optional(Schema.String),
+})
+const MCP = Schema.Struct({
+  $schema: Schema.Literal("https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"),
+  mcpServers: Schema.Record(Schema.String, Schema.Unknown),
+})
+const Frontmatter = Schema.Struct({
+  name: Schema.String.check(Schema.isPattern(/^(?!.*--)(?=.{1,64}$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/)),
+  description: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(1024)),
+  license: Schema.optional(Schema.String),
+  compatibility: Schema.optional(Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(500))),
+  metadata: Schema.optional(Schema.Record(Schema.String, Schema.String)),
+  "allowed-tools": Schema.optional(Schema.String),
+})
+
+export async function load(directory: string, data: string): Promise<Generation> {
+  const root = await realpath(directory)
+  const file = await contained(root, "plugin.json")
+  const input: unknown = await Bun.file(file).json()
+  const object = Schema.decodeUnknownSync(Schema.Record(Schema.String, Schema.Unknown))(input)
+  const fields = new Set(Object.keys(Manifest.fields))
+  const unknown = Object.keys(object).filter((key) => !fields.has(key))
+  if (unknown.length) console.warn(`Agent Plugin ${file}: ignoring unknown fields: ${unknown.join(", ")}`)
+  const manifest = Schema.decodeUnknownSync(Manifest, { onExcessProperty: "error" })(
+    Object.fromEntries(Object.entries(object).filter(([key]) => fields.has(key))),
+  )
+  if (
+    manifest.extensions !== undefined &&
+    (typeof manifest.extensions !== "object" || manifest.extensions === null || Array.isArray(manifest.extensions))
+  )
+    console.warn(`Agent Plugin ${file}: ignoring non-object extensions`)
+  const skills = await readSkills(root)
+  const servers = await readMcp(root, data)
+  return {
+    id: manifest.name,
+    source: { type: "local", path: file },
+    revision: JSON.stringify([input, skills, servers]),
+    effect: (ctx) =>
+      Effect.gen(function* () {
+        yield* ctx.skill.transform((editor) => {
+          skills.forEach((skill) => {
+            if (!editor.get(skill.id)) editor.add(skill)
+          })
+        })
+        yield* ctx.mcp.transform((editor) => {
+          servers.forEach(([name, config]) => {
+            if (!editor.get(name)) editor.set(name, config)
+          })
+        })
+      }),
+  }
+}
+
+async function readSkills(root: string): Promise<Skill.Info[]> {
+  const directory = await component(root, "skills", "directory")
+  if (!directory) return []
+  const children = await readdir(directory)
+  const skills = await Promise.all(
+    children.sort().map(async (name) => {
+      const file = await component(root, `skills/${name}/SKILL.md`, "file")
+      if (!file) return []
+      try {
+        const content = await Bun.file(file).text()
+        const markdown = ConfigMarkdown.parse(content)
+        const frontmatter = Schema.decodeUnknownSync(Frontmatter)(markdown.data)
+        if (frontmatter.name !== name) throw new Error("Skill name must match its directory")
+        const parsed = SkillFile.parse(directory, file, content)
+        return parsed._tag === "Parsed" ? [parsed.skill] : []
+      } catch (error) {
+        console.warn(`Agent Plugin: skipping skill ${file}: ${String(error)}`)
+        return []
+      }
+    }),
+  )
+  return skills.flat()
+}
+
+async function readMcp(root: string, data: string): Promise<[string, Mcp.ServerConfig][]> {
+  const file = await component(root, "mcp.json", "file")
+  if (!file) return []
+  try {
+    const config = Schema.decodeUnknownSync(MCP, { onExcessProperty: "error" })(await Bun.file(file).json())
+    const servers = await Promise.all(
+      Object.entries(config.mcpServers).map(async ([name, input]) => {
+        try {
+          // Remote transports are intentionally unsupported: native remote config cannot pin a transport.
+          const server = Schema.decodeUnknownSync(Stdio, { onExcessProperty: "error" })(input)
+          if (
+            !server.command ||
+            /\0/.test(server.command) ||
+            (!server.command.startsWith("./") && /[\s/\\$]/.test(server.command))
+          )
+            throw new Error("command must be a bare executable or a ./ package path, without placeholders")
+          if (
+            Object.keys(server.env ?? {}).some((key) =>
+              ["PLUGIN_ROOT", "PLUGIN_DATA"].includes(process.platform === "win32" ? key.toUpperCase() : key),
+            )
+          )
+            throw new Error("env must not override PLUGIN_ROOT or PLUGIN_DATA")
+          const command = server.command.startsWith("./") ? await contained(root, server.command) : server.command
+          const storage = path.join(data, "agent-plugins", Hash.sha256(root))
+          await mkdir(storage, { recursive: true })
+          const pluginData = await realpath(storage)
+          const expand = (value: string) =>
+            value.replace(/\$\{PLUGIN_(ROOT|DATA)\}/g, (_, key) => (key === "ROOT" ? root : pluginData))
+          const cwd = server.cwd ?? "${PLUGIN_ROOT}"
+          const base = cwd === "${PLUGIN_DATA}" || cwd.startsWith("${PLUGIN_DATA}/") ? pluginData : root
+          if (
+            !(
+              cwd.startsWith("./") ||
+              cwd === "${PLUGIN_ROOT}" ||
+              cwd.startsWith("${PLUGIN_ROOT}/") ||
+              cwd === "${PLUGIN_DATA}" ||
+              cwd.startsWith("${PLUGIN_DATA}/")
+            )
+          )
+            throw new Error("cwd must be rooted in ./, ${PLUGIN_ROOT}, or ${PLUGIN_DATA}")
+          const working = await contained(base, expand(cwd), true)
+          return [
+            [
+              name,
+              Mcp.LocalConfig.make({
+                type: "local",
+                command: [command, ...(server.args ?? []).map(expand)],
+                cwd: working,
+                environment: {
+                  ...Object.fromEntries(Object.entries(server.env ?? {}).map(([key, value]) => [key, expand(value)])),
+                  PLUGIN_ROOT: root,
+                  PLUGIN_DATA: pluginData,
+                },
+              }),
+            ] satisfies [string, Mcp.ServerConfig],
+          ]
+        } catch (error) {
+          console.warn(`Agent Plugin: skipping MCP server ${name}: ${String(error)}`)
+          return []
+        }
+      }),
+    )
+    return servers.flat()
+  } catch (error) {
+    console.warn(`Agent Plugin: disabling MCP ${file}: ${String(error)}`)
+    return []
+  }
+}
+
+async function component(root: string, file: string, kind: "file" | "directory") {
+  try {
+    const resolved = await contained(root, file)
+    const info = await stat(resolved)
+    if (kind === "file" ? info.isFile() : info.isDirectory()) return resolved
+    throw new Error(`Expected ${kind}`)
+  } catch (error) {
+    if (!(error instanceof Error && "code" in error && ["ENOENT", "ENOTDIR"].includes(String(error.code))))
+      console.warn(`Agent Plugin: invalid component ${file}: ${String(error)}`)
+    return undefined
+  }
+}
+
+async function contained(root: string, file: string, missing = false): Promise<string> {
+  const target = path.resolve(root, file)
+  const resolved = await realpath(target).catch(async (error: unknown): Promise<string> => {
+    if (
+      !missing ||
+      !(error instanceof Error && "code" in error && error.code === "ENOENT") ||
+      path.dirname(target) === target
+    )
+      throw error
+    return path.join(await contained(root, path.dirname(target), true), path.basename(target))
+  })
+  if (!FSUtil.contains(root, resolved)) throw new Error(`Package path escapes plugin root: ${file}`)
+  return resolved
+}
