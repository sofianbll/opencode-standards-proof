+it.live("discovers portable directories while still rejecting directories without a manifest or code entrypoint", () =>
+  Effect.gen(function* () {
+    const directory = yield* tmpdirScoped()
+    const portable = path.join(directory.path, "plugins/portable")
+    const configured = path.join(directory.path, "configured")
+    const invalid = path.join(directory.path, "plugins/invalid")
+    yield* Effect.promise(async () => {
+      await cp(path.join(import.meta.dir, "../fixture/agent-plugin"), portable, { recursive: true })
+      await cp(portable, configured, { recursive: true })
+      await mkdir(path.join(directory.path, "plugins/empty"), { recursive: true })
+      await Bun.write(path.join(invalid, "plugin.json"), "not JSON")
+      await Bun.write(path.join(directory.path, "plugins/code/index.ts"), "export default {}")
+    })
+    const config = yield* Config.Test
+    yield* config.setEntries([
+      new Directory({ type: "directory", path: AbsolutePath.make(directory.path) }),
+      new Document({ type: "document", info: new Info({ plugins: [configured] }) }),
+    ])
+    const source = yield* ConfigPluginSource.Service
+    expect((yield* source.operations()).map((operation) => operation.target)).toEqual([
+      path.join(directory.path, "plugins/code"),
+      invalid,
+      portable,
+      configured,
+    ])
+  }),
+)
